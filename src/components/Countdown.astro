---
import { EUDR_DEADLINE } from '../config';
const staticDate = '30 Dec 2026';
---
<span class="deadline">
  EUDR per-shipment DDS obligation begins&nbsp;<strong>{staticDate}</strong>
  <span id="countdown" data-deadline={EUDR_DEADLINE} hidden></span>
</span>

<script>
  import { countdownText } from '../lib/countdown';

  const el = document.getElementById('countdown');
  const text = el ? countdownText(el.dataset.deadline, new Date()) : null;
  if (el && text) {
    el.textContent = text;
    el.hidden = false;
  }
</script>

<style>
  .deadline { display: inline-flex; align-items: baseline; gap: 4px;
              background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.14);
              border-radius: 8px; padding: 10px 16px; font-size: 0.95rem; }
  strong { font-variant-numeric: tabular-nums; }
</style>
