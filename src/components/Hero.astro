---
import Topo from './Topo.astro';
---
<section class="hero band-deep">
  <div class="glow hero-glow" aria-hidden="true"></div>
  <Topo id="topo-hero" drift />

  <div class="wrap inner">
    <p class="eyebrow">Origin data to filed DDS</p>
    <h1>EUDR compliance that starts where your plot data <em>actually lives</em>.</h1>
    <p class="lede">
      Grovetrace pulls supplier and plot data out of the ERPs, farm-data tools
      and co-op spreadsheets it's stuck in, and ties every cocoa batch to the
      land it grew on. That becomes the Due Diligence Statement every shipment
      needs in TRACES from 30 December 2026. Built for cocoa first, and for the
      six other EUDR commodities that work the same way.
    </p>
    <div class="ctas">
      <a class="cta press" href="/demo/">Book a demo</a>
      <a class="ghost press" href="#how-it-works">See how it works</a>
    </div>
  </div>
</section>

<style>
  /* Keeps its own gradient rather than .band-deep's: the hero climbs further
     into the primary green than the closing band, which stays near-black so
     the two read as a pair without being the same picture. */
  .hero { position: relative; overflow: hidden; background: var(--hero-gradient);
          color: var(--on-deep); padding: 80px 0 96px; }
  .glow { position: absolute; top: -30%; left: 8%; width: 70%; height: 150%;
          background: radial-gradient(closest-side,
                      rgba(59, 206, 170, 0.22), rgba(59, 206, 170, 0) 70%);
          opacity: 0.4; pointer-events: none; }
  .inner { position: relative; z-index: 1; }
  h1 { font-size: clamp(2.1rem, 5.5vw, 3.4rem); max-width: 24ch; color: #fff; }
  h1 em { font-style: italic; color: var(--emerald); }
  .lede { margin: 22px 0 30px; font-size: 1.13rem; color: var(--on-deep-muted);
          max-width: 58ch; }
  .ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .cta { background: var(--emerald); color: #0B1D1C; text-decoration: none;
         padding: 13px 26px; border-radius: 8px; font-weight: 600; }
  .ghost { color: var(--on-deep); text-decoration: none; padding: 13px 20px;
           border: 1px solid var(--on-deep-border); border-radius: 8px; }
</style>
