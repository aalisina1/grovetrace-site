---
import { SITE } from '../config';
---
<footer class="band-alt">
  <div class="wrap inner">
    <div>© 2026 {SITE.name}</div>
    <div class="links">
      <a class="u-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <a class="u-link" href="/demo/">Book a demo</a>
      <a class="u-link" href="/privacy/">Privacy</a>
    </div>
  </div>
</footer>
<style>
  footer { padding: 34px 0 48px; font-size: 0.92rem;
           color: var(--muted-foreground); }
  .inner { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 18px; }
  a { color: var(--primary); text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>
