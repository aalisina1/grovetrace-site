---
import { SITE, CAL_LINK } from '../config';

/**
 * The booking step, embedded. Qualification lives in Cal.com's own booking
 * questions rather than in a separate form, so a prospect books in one place
 * and the answers arrive attached to the calendar invite.
 *
 * Only rendered on /demo/. The home page links here rather than embedding, so
 * a casual visitor never loads Cal's script.
 */
const CAL_URL = `https://cal.com/${CAL_LINK}`;
---
<section class="demo" id="demo">
  <div class="wrap inner">
    <h1>Book a demo</h1>
    <p class="lede">
      Twenty minutes, screen shared. I'll show how supplier and plot data from
      the systems you already run turns into a filed Due Diligence Statement,
      and where it usually goes wrong before it gets there.
    </p>

    <ul class="covers">
      <li>Connecting a source and mapping it once</li>
      <li>What the worklist tells you on a Monday morning</li>
      <li>Plots, blending, and what survives to the statement</li>
      <li>Your questions, which is most of it</li>
    </ul>

    <div id="cal-inline"></div>

    <noscript>
      <p class="fallback">
        <a class="cta" href={CAL_URL} target="_blank" rel="noopener">
          Open the booking page
        </a>
      </p>
    </noscript>

    <p id="cal-fallback" class="fallback" hidden></p>

    <p class="alt">
      Would rather just write? Email
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a> and I'll reply the same day.
    </p>
  </div>
</section>

<script>
  import EmbedSnippet from '@calcom/embed-snippet';
  import { CAL_LINK } from '../config';

  const CAL_URL = `https://cal.com/${CAL_LINK}`;
  const fallbackEl = document.getElementById('cal-fallback');

  function showFallback() {
    if (!fallbackEl || !fallbackEl.hidden) return;
    fallbackEl.innerHTML =
      `The calendar didn't load. Some browser extensions block it. ` +
      `<a href="${CAL_URL}" target="_blank" rel="noopener">Open the booking page instead</a>.`;
    fallbackEl.hidden = false;
  }

  try {
    const Cal = EmbedSnippet();
    Cal('inline', { elementOrSelector: '#cal-inline', calLink: CAL_LINK });
    Cal('ui', { hideEventTypeDetails: false, layout: 'month_view' });
    // The script can be blocked after loading begins; if nothing has rendered
    // shortly after, offer the plain link rather than a blank box.
    window.setTimeout(() => {
      const el = document.getElementById('cal-inline');
      if (!el || el.childElementCount === 0) showFallback();
    }, 5000);
  } catch {
    showFallback();
  }
</script>

<style>
  .demo { padding: 56px 0 72px; }
  .inner { max-width: 760px; }
  h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); margin-bottom: 12px; }
  .lede { color: var(--muted-foreground); font-size: 1.06rem; margin-bottom: 20px; }

  .covers { list-style: none; margin: 0 0 28px; display: grid; gap: 7px; }
  .covers li {
    color: var(--muted-foreground); font-size: 0.97rem;
    padding-left: 20px; position: relative;
  }
  .covers li::before {
    content: ''; position: absolute; left: 0; top: 0.55em;
    width: 7px; height: 7px; border-radius: 50%; background: var(--primary);
  }

  #cal-inline { min-height: 560px; }

  [hidden] { display: none !important; }
  .fallback { margin-top: 14px; color: var(--muted-foreground); font-size: 0.95rem; }
  .fallback a { color: var(--primary); }
  .cta {
    display: inline-block; background: var(--primary); color: #fff !important;
    text-decoration: none; padding: 13px 28px; border-radius: 8px; font-weight: 600;
  }
  .alt { margin-top: 22px; color: var(--muted-foreground); font-size: 0.93rem; }
  .alt a { color: var(--primary); }
</style>
