---
import { APP_URL } from '../config';
import { buildNavLinks } from '../lib/nav';
const links = buildNavLinks(APP_URL);
---
<nav class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label="Grovetrace home">
      <svg width="26" height="26" viewBox="0 0 100 100" aria-hidden="true">
        <polygon points="50,9 82,29 71,63 29,61 18,27" fill="none"
          stroke="currentColor" stroke-width="8" stroke-linejoin="round"/>
        <circle cx="50" cy="9" r="7.5" fill="currentColor"/>
        <circle cx="82" cy="29" r="7.5" fill="currentColor"/>
        <circle cx="71" cy="63" r="7.5" fill="currentColor"/>
        <circle cx="29" cy="61" r="7.5" fill="currentColor"/>
        <circle cx="18" cy="27" r="7.5" fill="currentColor"/>
        <rect x="45.75" y="63" width="8.5" height="28" rx="4" fill="currentColor"/>
      </svg>
      <span>Grovetrace</span>
    </a>
    <ul>
      {links.map((l) => (
        <li>
          <a href={l.href} class={l.label === 'Book a demo' ? 'cta press' : 'u-link'}>{l.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  /*
   * Chrome that reacts to where you are in the page. The class is toggled
   * rather than styles being written inline, so all the presentation stays in
   * CSS and honours prefers-reduced-motion with it.
   *
   * Guarded on rAF so a fast scroll cannot queue a style write per event.
   */
  const nav = document.querySelector('.nav');
  if (nav) {
    let ticking = false;
    const sync = () => {
      nav.classList.toggle('is-scrolled', window.scrollY > 12);
      ticking = false;
    };
    sync();
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(sync);
      },
      { passive: true },
    );
  }
</script>

<style>
  .nav { position: sticky; top: 0; z-index: 50; backdrop-filter: blur(8px);
         background: color-mix(in srgb, var(--background) 85%, transparent);
         border-bottom: 1px solid var(--border); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between;
               padding-block: 18px; flex-wrap: wrap; row-gap: 8px; }

  /* Condense once the page has moved. Padding and the mark tighten, and the
     bar gains a little depth, so the chrome tracks where you are. */
  .nav.is-scrolled .nav-inner { padding-block: 11px; }
  .nav.is-scrolled { box-shadow: 0 1px 0 var(--border), 0 8px 24px -20px rgba(11, 29, 28, 0.5); }
  .nav.is-scrolled .brand svg { transform: scale(0.9); }
  .nav.is-scrolled .brand { font-size: 1.12rem; }

  @media (prefers-reduced-motion: no-preference) {
    .nav, .nav-inner, .brand, .brand svg {
      transition: padding-block 220ms var(--ease-out-soft),
                  box-shadow 220ms var(--ease-out-soft),
                  font-size 220ms var(--ease-out-soft),
                  transform 220ms var(--ease-out-soft);
    }
  }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700;
           font-size: 1.2rem; color: var(--primary); text-decoration: none; }
  .brand span { color: var(--foreground); }
  ul { display: flex; gap: 22px; list-style: none; align-items: center;
       flex-wrap: wrap; row-gap: 8px; }
  a { color: var(--muted-foreground); text-decoration: none; font-size: 0.95rem; }
  a:hover { color: var(--foreground); }
  .cta { background: var(--primary); color: var(--primary-foreground);
         padding: 9px 18px; border-radius: 8px; font-weight: 600; }
  @media (max-width: 640px) { ul { gap: 14px; font-size: 0.9rem; } }
  /* Brand + three links + a padded CTA don't fit in ~272px of usable width
     (320px viewport minus .wrap's 24px×2 padding). Below that, the nav-inner
     wrap above already lets the ul drop to its own row; here we additionally
     tighten spacing and the CTA's own padding so that row fits too, without
     ever hiding the CTA, which is the page's primary conversion path. */
  @media (max-width: 380px) {
    ul { gap: 10px; }
    .cta { padding: 9px 14px; }
  }
</style>
